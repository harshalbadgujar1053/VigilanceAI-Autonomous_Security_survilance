 export const fetchSiemAlerts = async (): Promise<Alert[]> => {
-  // Always returns sample alerts as specified (hardcoded, no API)
-  return Object.values(SAMPLE_ALERTS);
+  try {
+    const res = await fetch(`${BASE_URL}/alerts`, { signal: AbortSignal.timeout(3000) });
+    if (!res.ok) throw new Error('API server error');
+    const data = await res.json();
+    if (data.success && Array.isArray(data.alerts) && data.alerts.length > 0) {
+      // raw_data is the original Wazuh-shaped alert (id/rule/agent) saved by
+      // wazuh_forwarder.py — already matches the Alert type directly.
+      return data.alerts.map((row: any) => (row.raw_data ? row.raw_data : {
+        id: row.id,
+        timestamp: row.timestamp,
+        rule: { id: row.rule_id, level: row.rule_level, description: row.description, groups: [] },
+        agent: { id: row.id, name: row.agent_name, ip: row.agent_ip }
+      })) as Alert[];
+    }
+    // Backend is up but has no live alerts yet (forwarder not running / no attacks
+    // simulated) — fall back to demo data so the UI isn't empty.
+    return Object.values(SAMPLE_ALERTS);
+  } catch (err) {
+    console.warn('Backend unreachable or empty — showing sample alerts.');
+    return Object.values(SAMPLE_ALERTS);
+  }
 };
 
