 FASTAPI_CLASSIFY_ENDPOINT  = f"{FASTAPI_BASE}/classify"
+FASTAPI_ALERTS_SAVE_ENDPOINT = f"{FASTAPI_BASE}/alerts/save"
 
 WAZUH_MANAGER_CONTAINER = "single-node-wazuh.manager-1"
